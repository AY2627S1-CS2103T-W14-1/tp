<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="false" title="Contact Details" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@ContactDetailsWindow.css" />
      </stylesheets>
      <VBox spacing="14">
        <padding>
          <Insets top="20" right="24" bottom="20" left="24" />
        </padding>
        <Label fx:id="name" id="contactName" />
        <GridPane hgap="14" vgap="10">
          <columnConstraints>
            <ColumnConstraints minWidth="90" />
            <ColumnConstraints minWidth="260" />
          </columnConstraints>
          <children>
            <Label text="Contact ID" GridPane.rowIndex="0" />
            <Label fx:id="contactId" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Role" GridPane.rowIndex="1" />
            <Label fx:id="role" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Phone" GridPane.rowIndex="2" />
            <Label fx:id="phone" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Email" GridPane.rowIndex="3" />
            <Label fx:id="email" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Location" GridPane.rowIndex="4" />
            <Label fx:id="locationLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="Tags" GridPane.rowIndex="5" />
            <Label fx:id="tags" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
          </children>
        </GridPane>
        <Button mnemonicParsing="false" onAction="#handleClose" text="Close" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
