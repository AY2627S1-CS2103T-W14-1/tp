<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="false" title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpMessageContainer">
        <children>
          <TextArea fx:id="helpMessage" editable="false" focusTraversable="false" prefHeight="440"
                    prefWidth="600" wrapText="true" />
        </children>
        <padding>
          <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
        </padding>
      </VBox>
    </Scene>
  </scene>
</fx:root>
