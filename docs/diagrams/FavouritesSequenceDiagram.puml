@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant "f:FavouriteCommand" as FavouriteCommand LOGIC_COLOR
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant "a:AddressBook" as AddressBook MODEL_COLOR
participant "l:FavouritesCommand" as FavouritesCommand LOGIC_COLOR

[-> FavouriteCommand : execute(m)
activate FavouriteCommand
FavouriteCommand -> ModelManager : getAddressBook()
activate ModelManager
ModelManager --> FavouriteCommand : a
deactivate ModelManager
FavouriteCommand -> AddressBook : getPersonList()
activate AddressBook
AddressBook --> FavouriteCommand : contacts
deactivate AddressBook
note over FavouriteCommand : Match the contact's name and suffix.
alt target exists
    FavouriteCommand -> ModelManager : setFavourite(target, true)
    activate ModelManager
    ModelManager -> AddressBook : setFavourite(target, true)
    activate AddressBook
    AddressBook --> ModelManager
    deactivate AddressBook
    ModelManager --> FavouriteCommand
    deactivate ModelManager
    [<-- FavouriteCommand : result
else target missing
    [<-- FavouriteCommand : throws CommandException
end
deactivate FavouriteCommand

[-> FavouritesCommand : execute(m)
activate FavouritesCommand
FavouritesCommand -> ModelManager : showFavouritePersons()
activate ModelManager
ModelManager -> ModelManager : updateFilteredPersonList(a::isFavourite)
ModelManager --> FavouritesCommand
deactivate ModelManager
FavouritesCommand -> ModelManager : getFilteredPersonList()
activate ModelManager
ModelManager --> FavouritesCommand : favourite contacts
deactivate ModelManager
[<-- FavouritesCommand : result with count or empty-state message
deactivate FavouritesCommand
@enduml
